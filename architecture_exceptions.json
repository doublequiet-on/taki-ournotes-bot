    "records": {"reason": "既有领域记录定义在带来源组合的 data 门面中。", "owner": "Data 维护者", "remove_when": "实际迁出单份领域类型时，来源改用纯契约并删除对应边。"},
    "query-entry": {"reason": "既有查询借用 commands 的分页、匹配或 structured_query 的结果入口。", "owner": "Query 维护者", "remove_when": "触及该能力时提取纯分页/匹配/结果契约，调用方迁移后删除边；分数表切片已取消。"},
    "source-facts": {"reason": "现有查询直接消费来源 DTO、歌曲属性或历史读取；编排尚未分离。", "owner": "Query / Data 维护者", "remove_when": "该能力迁至规范化快照与应用编排时移除具体来源导入。"},
    "debug": {"reason": "直接调试命令读取 natural_query 的进程计数，未调用模型。", "owner": "Query 维护者", "remove_when": "诊断计数有独立纯接口后迁移命令依赖。"},
    "render-facts": {"reason": "既有绘图消费查询结果、来源 DTO、素材身份；旧成员列表仍能刷新摘要。", "owner": "Rendering 维护者", "remove_when": "相关绘图切片完成视图与素材准备后，用运行时禁源/禁网验收并移除具体导入。"},
    "visual-facade": {"reason": "拆出的渲染模块仍借用 visuals 的私有主题、素材和编码函数。", "owner": "Rendering 维护者", "remove_when": "真实复用组件及素材准备迁出时替换私有调用，移除逐符号例外。"},
    "source-shared": {"reason": "来源适配器借用现有谱面解析、榜线缓存条目、数值/玩家校验及网络槽。", "owner": "Data 维护者", "remove_when": "触及谱面/榜线适配时提取实际共用契约与校验，旧缓存语义验证后删边。"}
