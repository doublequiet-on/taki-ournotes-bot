# Release preset: merge these keys into the server environment after review.
# Do not replace the existing configuration or its credentials with this file.
# New installations keep periodic sampling disabled unless this preset is applied.
OURNOTES_CUTOFF_HISTORY=1
OURNOTES_CUTOFF_SAMPLING=1
OURNOTES_CUTOFF_SAMPLING_SERVERS=jp,hk,kr,en
OURNOTES_CUTOFF_SAMPLING_INTERVAL=300
OURNOTES_CUTOFF_MIN_FREE_MB=512
