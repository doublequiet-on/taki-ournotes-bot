+// Treat the little-endian hash bytes as a big-endian digit sequence.
+fn encode_hash(bytes: [u8; 16], alphabet: &[u8]) -> String {
+  let leading_zeroes = bytes.iter().take_while(|&&byte| byte == 0).count();
+  let radix = alphabet.len() as u128;
+  let mut value = u128::from_be_bytes(bytes);
+  let mut digits = Vec::with_capacity(25);
+
+  while value != 0 {
+    digits.push(alphabet[(value % radix) as usize]);
+    value /= radix;
+  }
+  digits.extend(std::iter::repeat_n(alphabet[0], leading_zeroes));
+  digits.reverse();
+  String::from_utf8(digits).expect("hash alphabet is ASCII")
+}
+
 pub fn xxhash_base64_url(input: &[u8]) -> String {
-  to_string(&xxh3_128(input).to_le_bytes(), 64, CHARACTERS_BASE64).unwrap()
+  encode_hash(xxh3_128(input).to_le_bytes(), CHARACTERS_BASE64)
 }
 
