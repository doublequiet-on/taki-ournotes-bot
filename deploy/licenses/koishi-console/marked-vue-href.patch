+// Decode exactly once using the browser's HTML attribute rules. The template
+// is inert; raw quotes are encoded before parsing so input stays in one attribute.
+function decodeHrefAttribute(value: string) {
+  const template = document.createElement('template')
+  template.innerHTML = `<a href="${xss.escapeAttrValue(value)}"></a>`
+  return template.content.firstElementChild!.getAttribute('href') || ''
+}
