# Preparation template only. Replace console.example.invalid with the agreed FQDN.
# Include inside nginx's http {}. Keep this file for HTTP-01 renewals after TLS setup.
server {
    listen 80;
    server_name console.example.invalid;
    if ($host != console.example.invalid) { return 421; }
    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/taki-console-acme;
        default_type text/plain;
        try_files $uri =404;
        limit_except GET { deny all; }
    }
    location / {
        return 308 https://console.example.invalid$request_uri;
    }
}
