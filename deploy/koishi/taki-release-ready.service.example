[Unit]
Description=Wake the validated Taki updater after a successful main release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=150
ExecStart=/usr/bin/python3.12 -B /usr/local/lib/taki-updater/linux_backend.py --config /etc/taki-updater.json watch-ready
