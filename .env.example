QQ_APP_ID=
QQ_APP_SECRET=
OURNOTES_CACHE_FILE=data/ournotes-cache.json
OURNOTES_CACHE_TTL_HOURS=0.5
# 完整谱面默认 Haneoka 固定日服版本；失败仅使用该来源旧缓存。
# 人工切换此项不会改变主资料、分数表或榜线来源。
OURNOTES_CHART_SOURCE=haneoka
# 主资料与图片默认 Haneoka JP 固定版本，中文文本须核对实体与规则一致。
OURNOTES_DATA_SOURCE=haneoka
# 使用安装包时可指定自己的昵称表；留空则使用安装包内置词表。
# OURNOTES_ALIAS_FILE=query_aliases.json
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_DAILY_LIMIT=100
# 同时处理的查询/绘图任务数，以及额外等待的任务数；满额时立即提示稍后重试。
OURNOTES_QUERY_CONCURRENCY=2
OURNOTES_QUERY_QUEUE_LIMIT=4
# 一条消息最多执行几条指令（按行拆分，空白行忽略；上限 4）。
# QQ 对同一消息的被动回复次数上限为 5，其中 1 次留给超限提示。
OURNOTES_MULTI_COMMAND_LIMIT=4
# WebSocket 网关域名。服务端仍下发已停用的 api.sgroup.qq.com，
# 这里改为统一域名 api.bot.qq.com；置空则保留服务端下发的地址。
OURNOTES_QQ_GATEWAY_HOST=api.bot.qq.com
# 是否按"收到消息的先后"发送回复（1/0、true/false、yes/no、on/off）。
# 开启：不会出现后问先答，但排在慢查询后面的快查询要多等一会儿。
# 关闭：谁先算完谁先发，响应更快，但可能后问先答。默认开启。
OURNOTES_REPLY_ORDER=1
# 自动更新成功后向已记录的群发送简短更新通知；关闭主动消息的群不接收。
OURNOTES_UPDATE_NOTICES=1
# 可选：AI 请求计数文件；默认与 OURNOTES_CACHE_FILE 放在同一目录。
# OURNOTES_AI_QUOTA_FILE=data/ai-quota.json
# 可选：不含查询正文、用户或群标识的 AI 分类统计文件。
# OURNOTES_AI_METRICS_FILE=data/ai-metrics.json

# 榜线历史写入与周期采样分开控制；安装默认不启动采样。
OURNOTES_CUTOFF_HISTORY=1
# OURNOTES_CUTOFF_HISTORY_FILE=data/moenotes-history-v1.sqlite3
OURNOTES_CUTOFF_SAMPLING=0
OURNOTES_CUTOFF_SAMPLING_SERVERS=jp,hk,kr,en
OURNOTES_CUTOFF_SAMPLING_INTERVAL=300
# 磁盘可用空间不足时暂停历史写入与采样，保留现有数据和当前查询。
OURNOTES_CUTOFF_MIN_FREE_MB=512

# 分数表使用 Haneoka 自身普通／激奏参考结果（效率与倍率），非旧 Moenotes 八类算法。
OURNOTES_META_SOURCE=haneoka-site
# 榜线默认 Haneoka Game Records；上游观测来自 MoeNotes tracker。
# 挑战歌曲用名称或歌曲ID查询；原始歌曲序号未确认。见 docs/HANEOKA_UNIFIED.md。
# 独立缓存 haneoka-cutoff-v1；历史 haneoka-cutoff-history-v3.sqlite3，不自动切回旧源。
OURNOTES_CUTOFF_SOURCE=haneoka
# 仅在安全配置中提供，仅需 moenotes:rankings；不要贴进聊天或写入仓库。
MOENOTES_OPEN_SECRET=
# 也支持 BDON_OPENPLATFORM；两者均非空时 MOENOTES_OPEN_SECRET 优先。只需设置一个。
BDON_OPENPLATFORM=
# OURNOTES_OPEN_HISTORY_FILE=data/moenotes-open-history-v2.sqlite3
