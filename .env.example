QQ_APP_ID=
QQ_APP_SECRET=
OURNOTES_CACHE_FILE=data/ournotes-cache.json
OURNOTES_CACHE_TTL_HOURS=6
# 使用安装包时可指定自己的昵称表；留空则使用安装包内置词表。
# OURNOTES_ALIAS_FILE=query_aliases.json
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_DAILY_LIMIT=100
# 同时处理的查询/绘图任务数，以及额外等待的任务数；满额时立即提示稍后重试。
OURNOTES_QUERY_CONCURRENCY=2
OURNOTES_QUERY_QUEUE_LIMIT=4
# 一条消息最多执行几条指令（按行拆分，空白行忽略；上限 10）。
# QQ 对同一消息的被动回复次数有限，调高前请先实测。
OURNOTES_MULTI_COMMAND_LIMIT=5
# 可选：AI 请求计数文件；默认与 OURNOTES_CACHE_FILE 放在同一目录。
# OURNOTES_AI_QUOTA_FILE=data/ai-quota.json
